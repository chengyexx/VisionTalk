# Vision Talk — API 密钥配置
# 复制此文件为 .env 并填入你的 API Key

# DeepSeek (主模型)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI (可选，用于 Whisper ASR 和 TTS 备选)
OPENAI_API_KEY=sk-your-openai-key

# Qwen 通义千问 (可选)
DASHSCOPE_API_KEY=sk-your-dashscope-key

# 默认模型
DEFAULT_VLM_MODEL=deepseek/deepseek-chat
DEFAULT_ASR_MODEL=whisper-1
DEFAULT_TTS_MODEL=openai/tts-1

# Edge TTS 语音 (免费，无需 API Key)
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# VLM 参数
VLM_MAX_TOKENS=1024
VLM_TEMPERATURE=0.7

# TTS 参数
TTS_VOICE=alloy
TTS_SPEED=1.0

# 记忆压缩模型 (用纯文本模型即可，成本极低)
SUMMARY_MODEL=deepseek/deepseek-chat
