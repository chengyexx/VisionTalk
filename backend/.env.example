# Vision Talk — API 密钥配置
# 复制此文件为 .env 并填入你的 API Key

# ── API Keys ──────────────────────────────────────────────────────

# DeepSeek — 对话补全、记忆压缩 (纯文本)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ASR 语音识别 — Groq Whisper (OpenAI 兼容, 免费额度)
OPENAI_API_KEY=gsk-your-groq-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Qwen 通义千问 — DashScope (多模态主力)
DASHSCOPE_API_KEY=sk-your-dashscope-key

# ── 默认模型 ──────────────────────────────────────────────────────

DEFAULT_VLM_MODEL=dashscope/qwen-vl-max       # Qwen VL Max (支持图片输入)
DEFAULT_ASR_MODEL=whisper-large-v3            # Groq Whisper (OpenAI 兼容)
DEFAULT_TTS_MODEL=

# ── Edge TTS (免费，无需 API Key) ─────────────────────────────────
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# ── VLM 参数 ──────────────────────────────────────────────────────
VLM_MAX_TOKENS=1024
VLM_TEMPERATURE=0.7

# ── TTS 参数 ──────────────────────────────────────────────────────
TTS_VOICE=alloy
TTS_SPEED=1.0

# ── 记忆压缩模型 (纯文本，不需要视觉) ───────────────────────────
SUMMARY_MODEL=deepseek/deepseek-chat
